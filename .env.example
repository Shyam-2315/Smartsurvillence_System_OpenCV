# Local Windows webcam: 0 (or 1 for a second camera). Docker on Windows is best used with RTSP.
CAMERA_SOURCE=0
# Source identity/mode preserve CAMERA_SOURCE compatibility. For the airborne
# ground receiver, set CAMERA_ID=AIR-01, CAMERA_MODE=airborne, and choose either
# a discovered USB index (for example CAMERA_SOURCE=1) or an RTSP/IP URL.
CAMERA_ID=CAM-01
CAMERA_NAME=Primary Camera
CAMERA_MODE=fixed
AIRBORNE_TELEMETRY_ENABLED=false
AIRBORNE_TELEMETRY_API_KEY=
AIRBORNE_TELEMETRY_STORE_INTERVAL_SECONDS=2
# Airborne mission and read-only ArduPilot SITL telemetry.
AIRBORNE_ENABLED=true
AIRBORNE_CAMERA_ID=AIR-01
AIRBORNE_CAMERA_NAME=VAYU-X
# CAMERA_SOURCE=1
# CAMERA_SOURCE=rtsp://username:password@camera.example:554/stream1
YOLO_MODEL=backend/yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
DATABASE_PATH=backend/surveillance.db
CAPTURE_DIRECTORY=outputs
TELEGRAM_ENABLED=false
BOT_TOKEN=
CHAT_ID=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
CAMERA_RETRY_SECONDS=3
# Browser-visible URL; use localhost:8001 for Docker Desktop on Windows.
# Local Vite: http://127.0.0.1:8001. Docker nginx: /api.
VITE_API_BASE_URL=http://127.0.0.1:8001
# Keep authentication enabled even on a trusted LAN. Generate the hash with:
# backend\.venv\Scripts\python.exe -c "import bcrypt; print(bcrypt.hashpw(b'change-me', bcrypt.gensalt()).decode())"
AUTH_ENABLED=true
JWT_SECRET=
JWT_EXPIRY_MINUTES=480
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
PROTECT_MONITORING_ROUTES=false
# false is appropriate only for local development or a trusted LAN protected by
# a firewall/VPN. Public deployments should set this true and use same-site
# secure cookies or short-lived stream tokens for browser-native MJPEG.
# true only when TLS terminates before nginx/backend.
COOKIE_SECURE=false
VISUAL_MAX_UPLOAD_MB=15
RECORDED_MISSION_MAX_UPLOAD_MB=2048
RECORDED_MISSION_STORAGE=outputs/missions
RECORDED_ANALYSIS_SAMPLE_FPS=2
RECORDED_ANALYSIS_MAX_CONCURRENT_JOBS=1
RECORDED_EVENT_MERGE_GAP_SECONDS=2
MAVLINK_ENABLED=true
# pymavlink listener syntax: SITL/Mission Planner should send to UDP port 14551.
MAVLINK_CONNECTION=udpin:127.0.0.1:14551
MAVLINK_READ_ONLY=true
MAVLINK_SIMULATION_MODE=true
MAVLINK_HEARTBEAT_TIMEOUT_SECONDS=5
MAVLINK_RECONNECT_SECONDS=3
MAVLINK_DISCONNECT_SECONDS=15
COMPANION_HEALTH_ENABLED=false
# Dedicated Pi device credential for POST /companion/health/AIR-01; never use an admin JWT.
COMPANION_HEALTH_API_KEY=
# Bench-tested real Pixhawk example: set MAVLINK_SIMULATION_MODE=false and use
# a dedicated forwarding endpoint such as udpin:127.0.0.1:14551. Direct serial
# is supported as MAVLINK_CONNECTION=COM7, but do not share that COM port with
# Mission Planner; COM7 is only an example, never a required port.
AIRBORNE_TELEMETRY_STALE_SECONDS=5
AIRBORNE_TELEMETRY_ASSOCIATION_MAX_SECONDS=3
# Optional web investigation (currently supports Brave Search API).
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=disabled
WEB_SEARCH_API_KEY=
# Bounded analyst-initiated requests only. Never place this key in VITE_* variables.
WEB_SEARCH_MAX_QUERIES=3
WEB_SEARCH_RESULTS_PER_QUERY=5
WEB_SEARCH_TIMEOUT_SECONDS=8
# A future local super-resolution provider is intentionally disabled by default.
IMAGE_SUPER_RESOLUTION_ENABLED=false
# EasyOCR models are stored under outputs/visual_intelligence/models/easyocr.
# Keep false to avoid an unplanned model download during an investigation.
OCR_MODEL_DOWNLOAD_ENABLED=false
